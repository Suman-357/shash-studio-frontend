# Vercel / Production Frontend Environment Variables
# In Vite, variables MUST start with "VITE_" to be accessible in the browser!

# Your deployed backend production URL (e.g. Render, Railway, AWS, Fly.io)
# You can provide with or without /api/v1 (both will be handled automatically)
VITE_API_URL=https://your-backend-service.onrender.com/api/v1
